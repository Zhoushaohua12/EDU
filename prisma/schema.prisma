generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  student
  admin
}

enum Stage {
  primary
  middle
}

enum QuestionType {
  single
  fill
}

enum ProgressStatus {
  started
  completed
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(student)
  createdAt    DateTime   @default(now())
  progress     Progress[]
}

model Subject {
  id        String   @id @default(cuid())
  stage     Stage
  grade     Int
  slug      String
  name      String
  sortOrder Int      @default(0)
  units     Unit[]

  @@unique([stage, grade, slug])
}

model Unit {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  lessons   Lesson[]
}

model Lesson {
  id          String     @id @default(cuid())
  unitId      String
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  summary     String
  guide       String
  sourceUrl   String?
  sourceRawUrl String?
  sourcePath  String?
  sourceRepo  String?
  sortOrder   Int        @default(0)
  questions   Question[]
  progress    Progress[]
}

model Question {
  id        String       @id @default(cuid())
  lessonId  String
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      QuestionType
  prompt    String
  options   String?
  answer    String
  explanation String
  sortOrder Int          @default(0)
}

model Progress {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status    ProgressStatus @default(started)
  score     Int?
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  @@unique([userId, lessonId])
}
